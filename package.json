{
  "name": "org-mcp",
  "version": "0.1.0",
  "description": "MCP server providing org-capture and org-agenda style workflows backed by plain-text org files on disk.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "org-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p .",
